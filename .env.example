# ZENITH LIBRARY GORAKHPUR - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development.
# On Vercel, add these variables in Project Settings > Environment Variables.

# Production domain URL (Leave empty or set to https://zenithlibrary.in)
NEXT_PUBLIC_SITE_URL=https://zenithlibrary.in

# ==============================================================================
# METHOD 1 (RECOMMENDED): Google Apps Script Web App (NO Google Cloud Console needed!)
# Deploy the Apps Script from Extensions > Apps Script in your spreadsheet:
# https://docs.google.com/spreadsheets/d/1F2iVnO-9f5lXM5ze5fu5oHg6X7fOhFT7dNR4GQW368U/edit
# Paste the resulting Web App URL here:
# ==============================================================================
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# ==============================================================================
# METHOD 2 (OPTIONAL): Google Cloud Service Account
# ==============================================================================
GOOGLE_SHEETS_ID=1F2iVnO-9f5lXM5ze5fu5oHg6X7fOhFT7dNR4GQW368U
# GOOGLE_SERVICE_ACCOUNT_EMAIL=zenith-library-cms@your-project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
